<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份与设备迁移规则 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="jifen.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="jifen.db" />
    </device-transfer>
</data-extraction-rules>
